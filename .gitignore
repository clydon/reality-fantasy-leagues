# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# the embedding model's files, fetched at build (db/fetch-embedding-model.js)
/.models/

# typescript
*.tsbuildinfo
next-env.d.ts

# League backups (scripts/backup-leagues.js): real people's data, never committed
/backups/

# Screenshots of the running app can show real people (usernames, emails: the admin screens do), and the
# repo is public: keep captures out of git. Shoot zt- fixtures, or keep real-data captures outside the repo.
/docs/ux-baseline/
/docs/screenshots/
/captures/

# Playwright MCP browser logs and page snapshots (local tooling)
/.playwright-mcp/

# Impeccable scratch: decision sketches, question-page state, review screenshots
.impeccable/mocks/
.impeccable/questions/
.impeccable/review/
.impeccable/critique/

# scripts/session-loop.js: its state, hand-offs and session logs
/.session-loop/
